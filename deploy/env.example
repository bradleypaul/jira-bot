# Copy to ~/.config/jira-bot/env  (no quotes; systemd EnvironmentFile)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-api-token

# Watcher
JIRA_WATCH_JQL=assignee = currentUser() AND status = 'In Progress'
JIRA_WATCH_INTERVAL=30
JIRA_WORKSPACE=/home/YOU/jira-repos
# JIRA_STATE_FILE=/home/YOU/.local/state/jira-bot/seen.json
# JIRA_LOG_LEVEL=INFO
# JIRA_GIT_SSH=1
