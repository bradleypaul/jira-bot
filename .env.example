# Jira Cloud
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-api-token

# Passed into the agent container
ANTHROPIC_API_KEY=your-anthropic-api-key

# Opens pull requests. Leave unset to use `gh auth login` on this host.
# GITHUB_TOKEN=

# Agent (optional; see README for all settings)
# JIRA_BOT_LABEL=bot
# JIRA_BOT_MAX_BUDGET_USD=10
# JIRA_BOT_REVIEW_TRANSITION=review

# Watcher (optional)
# JIRA_WATCH_INTERVAL=30
# JIRA_WORKSPACE=/home/you/jira-repos
# JIRA_STATE_FILE=/home/you/.local/state/jira-bot/seen.json
# JIRA_LOG_LEVEL=INFO
# JIRA_GIT_SSH=1
